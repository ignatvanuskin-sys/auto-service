generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  name          String
  phone         String
  make          String
  model         String
  year          Int?
  engine        String
  serviceType   String
  comment       String?
  preferredTime String?
  source        String   @default("homepage")
  status        String   @default("new")
  managerNotes  String?

  @@index([status])
  @@index([createdAt])
}
